# Meta Model API. Leave unset to run the local reconstruction only.
# https://dev.meta.ai/docs/models
MODEL_API_KEY=

# Optional alias read by the server if MODEL_API_KEY is empty.
META_API_KEY=

# Local vision service used by the Next.js server.
VISION_URL=http://127.0.0.1:8742

# Relative depth checkpoint. Download with scripts/setup.sh.
DEPTH_MODEL_PATH=models/depth_anything_v2_small_q4.onnx

# Where memories are stored.
CHRONOSPACE_DATA=data
